                        </div>
                        <div className="flex items-center gap-2 pt-2 border-t border-slate-100 dark:border-slate-800">
                          <button onClick={() => handleToggleSave(book.id)} className={`p-2 rounded-lg border ${isSaved ? 'bg-[#EAE7F8] border-[#5B46E8] text-[#5B46E8]' : 'border-slate-200 dark:border-slate-700'}`}>
                            <Bookmark className="w-4 h-4" />
                          </button>
                          <button onClick={() => handleReadBook(book)} className="flex-1 py-1.5 px-3 rounded-lg border border-slate-200 dark:border-slate-700 text-xs font-medium">Read</button>
                          <button onClick={() => handleDownloadBook(book)} className={`flex-1 py-1.5 px-3 rounded-lg text-xs font-medium text-white flex items-center justify-center gap-1 ${isDownloaded ? 'bg-emerald-600' : 'bg-[#5B46E8]'}`}>
                            {isDownloaded ? <><CheckCircle2 className="w-3.5 h-3.5" /> Saved</> : 'Download'}
                          </button>
                        </div>
                      </div>
                    );
                  })}
                </div>
              )}
            </>
          )}
        </main>
      </div>

      {readingBook && currentChapter && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/55 p-4">
          <div className="w-full max-w-3xl max-h-[88vh] flex flex-col bg-white dark:bg-[#1B1A24] rounded-2xl border border-slate-200 dark:border-slate-800 p-6 shadow-2xl">
            <div className="flex items-start justify-between gap-4 pb-4 border-b border-slate-100 dark:border-slate-800">
              <div>
                <span className="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-[#EAE7F8] dark:bg-[#27233B] text-[#5B46E8] mb-1.5">
                  {readingBook.category} • Chapter {currentChapter.number} of {readerChapters.length}
                </span>
                <h2 className="text-lg font-bold leading-snug">{readingBook.title}</h2>
                <p className="text-xs text-slate-500 mt-0.5">By {readingBook.author} • Original study & reference edition</p>
              </div>
              <button onClick={() => setReadingBook(null)} className="text-slate-400 hover:text-slate-600">
                <X className="w-5 h-5" />
              </button>
            </div>

            <div className="flex flex-wrap gap-1.5 py-3 border-b border-slate-100 dark:border-slate-800">
              {readerChapters.map((ch, idx) => (
                <button
                  key={ch.number}
                  type="button"
                  onClick={() => setActiveChapterIdx(idx)}
                  className={`px-3 py-1 rounded-lg text-xs font-medium transition-colors ${
                    idx === activeChapterIdx
                      ? 'bg-[#5B46E8] text-white'
                      : 'bg-slate-100 dark:bg-[#252432] text-slate-600 dark:text-slate-300'
                  }`}
                >
                  Ch. {ch.number}: {ch.title}
                </button>
              ))}
            </div>

            <div className="flex-1 overflow-y-auto py-5 pr-1 space-y-4">
              <h3 className="text-base font-bold">
                Chapter {currentChapter.number}: {currentChapter.title}
              </h3>
              {currentChapter.paragraphs.map((para, pIdx) => (
                <p key={pIdx} className="text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
                  {para}
                </p>
              ))}
            </div>

            <div className="flex items-center justify-between gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
              <div className="flex items-center gap-2">
                <button
                  type="button"
                  disabled={activeChapterIdx === 0}
                  onClick={() => setActiveChapterIdx((prev) => Math.max(0, prev - 1))}
                  className="flex items-center gap-1 px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 text-xs font-semibold disabled:opacity-40"
                >
                  <ChevronLeft className="w-4 h-4" />
                  <span>Previous</span>
                </button>
                <button
                  type="button"
                  disabled={activeChapterIdx >= readerChapters.length - 1}
                  onClick={() => setActiveChapterIdx((prev) => Math.min(readerChapters.length - 1, prev + 1))}
                  className="flex items-center gap-1 px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 text-xs font-semibold disabled:opacity-40"
                >
                  <span>Next</span>
                  <ChevronRight className="w-4 h-4" />
                </button>
              </div>
              <button
                type="button"
                onClick={() => handleDownloadBook(readingBook)}
                className="px-4 py-2 rounded-xl bg-[#5B46E8] text-white text-xs font-semibold flex items-center gap-1.5"
              >
                <Download className="w-3.5 h-3.5" />
                <span>Download Full PDF</span>
              </button>
            </div>
          </div>
        </div>
      )}

      {selectedBook && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
          <div className="w-full max-w-xl bg-white dark:bg-[#1B1A24] rounded-2xl border border-slate-200 dark:border-slate-800 p-6 shadow-2xl">
            <div className="flex justify-between items-start gap-4">
              <div className="flex gap-5">
                <img src={selectedBook.cover_url} alt={selectedBook.title} className="w-28 h-40 object-cover rounded-xl shadow-md shrink-0 bg-slate-100" />
                <div>
                  <span className="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-[#EAE7F8] dark:bg-[#27233B] text-[#5B46E8] mb-2">{selectedBook.category}</span>
                  <h2 className="text-lg font-bold leading-snug">{selectedBook.title}</h2>
                  <p className="text-xs font-medium text-slate-500 mt-1">By {selectedBook.author}</p>
                  <p className="text-xs text-slate-600 dark:text-slate-300 mt-3 leading-relaxed">{selectedBook.description}</p>
                </div>
              </div>
              <button onClick={() => setSelectedBook(null)} className="text-slate-400 hover:text-slate-600"><X className="w-5 h-5" /></button>
            </div>
            <div className="flex justify-end gap-3 mt-6 pt-4 border-t border-slate-100 dark:border-slate-800">
              <button onClick={() => { const bookToRead = selectedBook; setSelectedBook(null); handleReadBook(bookToRead); }} className="px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-700 text-xs font-semibold">Read Chapters</button>
              <button onClick={() => { handleDownloadBook(selectedBook); setSelectedBook(null); }} className="px-5 py-2 rounded-xl bg-[#5B46E8] text-white text-xs font-semibold flex items-center gap-1.5">
                <Download className="w-3.5 h-3.5" /><span>Download PDF</span>
              </button>
            </div>
          </div>
        </div>
      )}

      {showAuthModal && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
          <div className="w-full max-w-md bg-white dark:bg-[#1B1A24] rounded-2xl border border-slate-200 dark:border-slate-800 p-6 shadow-2xl">
            <div className="flex items-center justify-between mb-4">
              <div className="flex items-center gap-2 text-sm font-bold">
                <Lock className="w-4 h-4 text-[#5B46E8]" />
                <span>{authMode === 'login' ? 'Member Log In' : 'Create Member Account'}</span>
              </div>
              <button onClick={() => setShowAuthModal(false)} className="text-slate-400"><X className="w-4 h-4" /></button>
            </div>
            <div className="grid grid-cols-2 gap-1 p-1 rounded-xl bg-slate-100 dark:bg-[#252432] mb-4">
              <button type="button" onClick={() => { setAuthMode('login'); setAuthError(''); }} className={`py-1.5 rounded-lg text-xs font-semibold ${authMode === 'login' ? 'bg-white dark:bg-[#1B1A24] text-[#5B46E8] shadow-xs' : 'text-slate-500'}`}>Log In</button>
              <button type="button" onClick={() => { setAuthMode('register'); setAuthError(''); }} className={`py-1.5 rounded-lg text-xs font-semibold ${authMode === 'register' ? 'bg-white dark:bg-[#1B1A24] text-[#5B46E8] shadow-xs' : 'text-slate-500'}`}>Sign Up</button>
            </div>
            {authError && <div className="mb-4 p-3 rounded-xl bg-red-50 text-xs text-red-600">{authError}</div>}
            <form onSubmit={handleAuthSubmit} className="space-y-3.5">
              {authMode === 'register' && (
                <div>
                  <label className="block text-xs font-medium mb-1 text-slate-600 dark:text-slate-300">Name</label>
                  <input type="text" value={fullName} onChange={(e) => setFullName(e.target.value)} placeholder="John Mark" className="w-full px-3 py-2 rounded-xl bg-slate-100 dark:bg-[#252432] text-xs focus:outline-none" required />
                </div>
              )}
              <div>
                <label className="block text-xs font-medium mb-1 text-slate-600 dark:text-slate-300">Email</label>
                <input type="text" value={authUsername} onChange={(e) => setAuthUsername(e.target.value)} placeholder="example@gmail.com" className="w-full px-3 py-2 rounded-xl bg-slate-100 dark:bg-[#252432] text-xs focus:outline-none" required />
              </div>
              <div>
                <label className="block text-xs font-medium mb-1 text-slate-600 dark:text-slate-300">Password</label>
                <input type="password" value={authPassword} onChange={(e) => setAuthPassword(e.target.value)} placeholder="password123" className="w-full px-3 py-2 rounded-xl bg-slate-100 dark:bg-[#252432] text-xs focus:outline-none" required />
              </div>
              <div className="flex justify-end gap-2 pt-2">
                <button type="button" onClick={() => setShowAuthModal(false)} className="px-4 py-2 rounded-xl border text-xs font-medium">Cancel</button>
                <button type="submit" disabled={authLoading} className="px-5 py-2 rounded-xl bg-[#5B46E8] text-white text-xs font-semibold">
                  {authLoading ? 'Please wait...' : authMode === 'login' ? 'Log In' : 'Create Account'}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}